---
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Título da aba e do resultado de busca. */
  title?: string;
  /** Descrição exibida no resultado de busca. */
  description?: string;
  /** URL canônica absoluta. Sem ela, é gerada a partir do domínio do site (astro.config) e da rota atual. */
  canonicalURL?: string | URL;
  /** Imagem de compartilhamento (Open Graph/Twitter): caminho do site ("/assets/og/x.jpg") ou URL absoluta. Ideal 1200×630. */
  image?: string;
  /** Texto alternativo da imagem de compartilhamento. */
  imageAlt?: string;
  /** Tipo Open Graph (og:type). Padrão: "website". */
  type?: string;
}

// Fallbacks genéricos da marca, usados quando a página não envia os dados.
const MARCA = {
  nome: 'PharmaUtility',
  title: 'PharmaUtility — Calibração, qualificação e validação de sistemas críticos',
  description: 'Calibração, qualificação e validação de equipamentos, sistemas e ambientes críticos para os setores farmacêutico, hospitalar, alimentício e industrial.',
  image: '/assets/og/capacete.jpg',
  imageAlt: 'Capacete de segurança cinza com o símbolo da PharmaUtility',
};

const {
  title = MARCA.title,
  description = MARCA.description,
  canonicalURL,
  image = MARCA.image,
  imageAlt = MARCA.imageAlt,
  type = 'website',
} = Astro.props;

// URLs absolutas com new URL(valor, Astro.site ?? Astro.url):
// - URLs absolutas já fornecidas (https://...) são preservadas pelo próprio new URL;
// - caminhos relativos ou iniciados por "/" são resolvidos sobre a base do site. A barra inicial é removida
//   e a base termina em "/", para não descartar o subcaminho do domínio (ex.: GitHub Pages /pharmautility-site).
const baseSite = new URL(Astro.site ?? new URL('/', Astro.url));
if (!baseSite.pathname.endsWith('/')) baseSite.pathname += '/';
const absoluta = (valor: string | URL) => new URL(String(valor).replace(/^\/(?!\/)/, ''), baseSite).href;

const canonical = absoluta(canonicalURL ?? Astro.url.pathname);
const imagemSocial = absoluta(image);
---

<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#40506A" />
    <!-- O site tem paleta própria só clara: impede o escurecimento automático do Chrome/Android e de outros navegadores. -->
    <meta name="color-scheme" content="only light" />
    <link rel="canonical" href={canonical} />
    <!-- Compartilhamento (WhatsApp, LinkedIn, Facebook, X) -->
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={MARCA.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagemSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagemSocial} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/assets/fonts/NasalizationRg-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/Montserrat-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <!-- Ícones (traço, herdam a cor do texto) -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <symbol id="i-arrow" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></symbol>
      <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
      <symbol id="i-phone" viewBox="0 0 24 24"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" /></symbol>
      <symbol id="i-pin" viewBox="0 0 24 24"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></symbol>
      <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></symbol>
      <symbol id="i-flask" viewBox="0 0 24 24"><path d="M9 3h6M10 3v6L5 18a2 2 0 0 0 1.7 3h10.6A2 2 0 0 0 19 18l-5-9V3" /><path d="M7.5 14h9" /></symbol>
      <symbol id="i-shield" viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z" /><path d="m9 12 2 2 4-4" /></symbol>
      <symbol id="i-layers" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5z" /><path d="m3 13 9 5 9-5" /></symbol>
      <symbol id="i-wind" viewBox="0 0 24 24"><path d="M3 9h11a3 3 0 1 0-3-3M3 15h15a3 3 0 1 1-3 3M3 12h7" /></symbol>
      <symbol id="i-gauge" viewBox="0 0 24 24"><path d="M4 16a8 8 0 1 1 16 0" /><path d="m12 16 4-4" /></symbol>
      <symbol id="i-thermo" viewBox="0 0 24 24"><path d="M10 14.5V5a2 2 0 0 1 4 0v9.5a4 4 0 1 1-4 0z" /></symbol>
      <symbol id="i-drop" viewBox="0 0 24 24"><path d="M12 3s6 6.2 6 10.5A6 6 0 0 1 6 13.5C6 9.2 12 3 12 3z" /></symbol>
      <symbol id="i-doc" viewBox="0 0 24 24"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h4" /></symbol>
      <symbol id="i-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><circle cx="12" cy="12" r="3" /></symbol>
      <symbol id="i-whatsapp" viewBox="0 0 24 24"><path d="M3.5 20.5 5 16.2A8.5 8.5 0 1 1 8.8 19.5z" /><path d="M9 9.5c0 2.8 2.7 5.5 5.5 5.5l1-1.4-2-1-.8.9a4 4 0 0 1-2-2l.9-.8-1-2z" /></symbol>
    </svg>

    <Header />

    <main id="conteudo" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
