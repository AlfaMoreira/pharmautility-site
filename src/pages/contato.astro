---
import Layout from '../layouts/Layout.astro';
import { servicos } from '../data/servicos.js';
---

<Layout title="Contato | PharmaUtility" description="Fale com a PharmaUtility: telefone, WhatsApp, endereço e formulário para solicitar uma proposta técnica." canonicalURL="/contato/">
  <section class="page-hero">
    <div class="container">
      <nav class="crumbs reveal" aria-label="Você está em">
        <a href="/">Início</a><span aria-hidden="true">/</span><span>Contato</span>
      </nav>
      <p class="eyebrow reveal">Contato</p>
      <h1 class="reveal" style="margin-top:18px; --d: 0.1s">Conte à nossa equipe o que seu projeto precisa.</h1>
      <p class="lead reveal" style="--d: 0.2s">
        Informe o sistema ou equipamento, a localização e o objetivo do trabalho para iniciarmos a avaliação da sua demanda.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:0" aria-labelledby="canais">
    <div class="container split">
      <div class="stack stack--col reveal">
        <article class="card">
          <span class="card__icon"><svg class="icon" aria-hidden="true"><use href="#i-whatsapp" /></svg></span>
          <h2 style="font-size:1.2rem; margin-top:18px">WhatsApp e telefone</h2>
          <p style="margin-top:8px"><a href="https://wa.me/5511944744013" target="_blank" rel="noopener" style="font-weight:600; color:var(--ink)">(11) 94474-4013</a></p>
        </article>
        <article class="card">
          <span class="card__icon"><svg class="icon" aria-hidden="true"><use href="#i-pin" /></svg></span>
          <h2 style="font-size:1.2rem; margin-top:18px">Endereço</h2>
          <address style="margin-top:8px; font-style:normal; line-height:1.7">
            Rua Serra de Botucatu, 878, sala 1503<br />
            Vila Gomes Cardim, São Paulo — SP<br />
            CEP 03317-000
          </address>
        </article>
        <article class="card">
          <span class="card__icon"><svg class="icon" aria-hidden="true"><use href="#i-drop" /></svg></span>
          <h2 style="font-size:1.2rem; margin-top:18px">Forma de atendimento</h2>
          <p style="margin-top:8px">Online para o Brasil e a América Latina, com suporte presencial mediante agendamento.</p>
        </article>
      </div>

      <div class="card quote-card reveal" style="--d: 0.1s">
        <h2 id="formulario" style="font-size:clamp(1.3rem, 1rem + 1vw, 1.8rem)">Solicitar proposta</h2>
        <p class="muted" style="margin-top:10px">Os campos com <span class="field__req-mark" style="color:var(--accent-text); font-weight:600">*</span> são obrigatórios.</p>

        <form class="form" data-whatsapp-form novalidate aria-labelledby="formulario" style="margin-top:28px">
          <div class="form__row">
            <div class="field">
              <label for="nome">Nome <span class="req" aria-hidden="true">*</span></label>
              <input id="nome" name="nome" type="text" autocomplete="name" required aria-describedby="nome-erro" />
              <p class="field__error" id="nome-erro" hidden>Informe seu nome para continuarmos.</p>
            </div>
            <div class="field">
              <label for="telefone">Telefone ou WhatsApp <span class="req" aria-hidden="true">*</span></label>
              <input id="telefone" name="telefone" type="tel" autocomplete="tel" inputmode="tel" required aria-describedby="telefone-erro" />
              <p class="field__error" id="telefone-erro" hidden>Informe um telefone com DDD para retorno.</p>
            </div>
          </div>

          <div class="form__row">
            <div class="field field--full">
              <label for="email">E-mail <span class="field__hint">(opcional)</span></label>
              <input id="email" name="email" type="email" autocomplete="email" />
            </div>
            <div class="field field--full">
              <label for="assunto">Assunto <span class="req" aria-hidden="true">*</span></label>
              <select id="assunto" name="assunto" required aria-describedby="assunto-erro">
                <option value="">Selecione um assunto</option>
                {servicos.map((s) => <option value={s.nome}>{s.nome}</option>)}
                <option value="Outro assunto">Outro assunto</option>
              </select>
              <p class="field__error" id="assunto-erro" hidden>Escolha o assunto mais próximo da sua demanda.</p>
            </div>
          </div>

          <div class="field">
            <label for="detalhes">Detalhes da demanda <span class="req" aria-hidden="true">*</span></label>
            <span class="field__hint" id="detalhes-dica">Descreva o sistema ou equipamento, a localização e o objetivo do trabalho.</span>
            <textarea id="detalhes" name="detalhes" rows="6" required minlength="10" aria-describedby="detalhes-dica detalhes-erro"></textarea>
            <p class="field__error" id="detalhes-erro" hidden>Conte um pouco mais (pelo menos 10 caracteres) para avaliarmos a demanda.</p>
          </div>

          <div class="form__actions">
            <button class="btn btn--primary" type="submit">
              <span>Enviar pelo WhatsApp</span>
              <span class="btn__icon"><svg class="icon" aria-hidden="true"><use href="#i-arrow" /></svg></span>
            </button>
            <p class="form__status" data-form-status role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>
